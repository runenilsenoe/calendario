# Public hostname; Caddy fetches a TLS certificate for it. Use :80 for plain HTTP.
DOMAIN=program.example.com

# Password for the bundled Postgres database. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Country code added to phone numbers entered without one, e.g. +47.
DEFAULT_PHONE_PREFIX=+47

# Set to false to stop new accounts from being created.
ALLOW_SIGNUP=true
